(script-fu-use-v3)
(gimp-message-set-handler ERROR-CONSOLE)

(define r (gimp-procedural-db-query "gimp-film-halftone" ".*" ".*" ".*"
                                   ".*" ".*" ".*" ".*"))
(gimp-message (string-append "NARGS=" (number->string (cadr r))))
(define n (cadr r))
(let loop ((i 0))
  (if (< i n)
      (let ((a (gimp-procedural-db-proc-arg "gimp-film-halftone" i)))
        (gimp-message (string-append "ARG" (number->string i)
                                     " | " (car a) " | " (cadr a)
                                     " | " (caddr a)))
        (loop (+ i 1)))))
(gimp-message "SIG DONE")
